{
    "title": {
        "en": "Set AC charging current"
    },
    "titleFormatted": {
        "en": "Set AC charging current to [[level]]"
    },
    "hint": {
        "en": "Limits how fast the car charges from a regular AC socket/wallbox (not DC fast charging). Lower it to avoid overloading a shared circuit or fuse. Only works on CCS2 vehicles."
    },
    "args": [
        {
            "type": "device",
            "name": "device",
            "filter": "driver_id=car"
        },
        {
            "type": "dropdown",
            "name": "level",
            "title": {
                "en": "Charging current"
            },
            "values": [
                {
                    "id": "1",
                    "title": {
                        "en": "100% (fastest)"
                    }
                },
                {
                    "id": "2",
                    "title": {
                        "en": "90%"
                    }
                },
                {
                    "id": "3",
                    "title": {
                        "en": "60% (slowest)"
                    }
                }
            ]
        }
    ]
